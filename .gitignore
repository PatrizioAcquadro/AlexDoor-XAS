# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated artifacts (see datasets/README.md and outputs/README.md)
# Datasets are tracked via their README.md; generated data stays local by default.
/datasets/*
!/datasets/README.md

# Learned-policy runs stay local. The five canonical source layers are tracked.
/outputs/*
!/outputs/README.md
!/outputs/door_scene/
/outputs/door_scene/*
!/outputs/door_scene/D[0-4].usda

# Legacy preparation payloads and evidence stay machine-local.
# Keep existing local artifacts ignored while the B1 workflow is still planned.
/assets/doors/phase4_1/source/
/assets/doors/phase4_1/normalized/
/assets/doors/phase4_1/evidence/

# B1 candidate metadata and recipes are tracked; generated attempts are local.
/assets/doors/b1/*/attempts/
/assets/doors/b1/*/prepared.json

# Machine-local artifacts
# Keep active binary formats ignored even outside datasets/ and outputs/.
*.log
*.hdf5
*.mp4
*.pt
# Binary USD caches; canonical scene layers use tracked .usda files.
*.usdc

# Local phase records
/implementation_phases/

# Local assistant state
/.agents/
/.codex/
/.claude/
/CLAUDE.md
/claude.md
/AGENTS.md
/agents.md
/TODO.md
/prompts/

# Editor and OS files
/knowledge/.obsidian/
.idea/
.vscode/
.DS_Store
