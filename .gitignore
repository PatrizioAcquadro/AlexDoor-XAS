# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated artifacts (see datasets/README.md and outputs/README.md)
# Track door records; recordings and prepared payloads stay local.
/datasets/*
!/datasets/README.md
!/datasets/doors/
/datasets/doors/b1/*/source/
/datasets/doors/b1/*/prepared/
/datasets/doors/b1/*/attempts/
/datasets/doors/b1/*/.publish/

# Track storage guidance, not run payloads.
/outputs/*
!/outputs/README.md
!/outputs/generated/
!/outputs/evidence/
/outputs/generated/*
!/outputs/generated/README.md
/outputs/evidence/*
!/outputs/evidence/README.md

# Machine-local artifacts
# Keep active binary formats ignored even outside datasets/ and outputs/.
*.log
*.hdf5
*.mp4
*.pt
# Binary USD caches; canonical scene layers use tracked .usda files.
*.usdc

# Local phase records
/implementation_phases/

# Local assistant state
/.agents/
/.codex/
/.claude/
/CLAUDE.md
/claude.md
/AGENTS.md
/agents.md
/TODO.md
/prompts/

# Editor and OS files
/knowledge/.obsidian/
.idea/
.vscode/
.DS_Store

# Model setup and requirements are documented in the wiki.
/models/
