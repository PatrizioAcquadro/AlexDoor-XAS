{
  "schema": "b1.perception.v1",
  "backbone": "facebook/dinov2-small",
  "image_size": 224,
  "history": 4,
  "sample_hz": 10,
  "max_gap_s": 0.15,
  "confidence_threshold": 0.5,
  "hidden_size": 128,
  "batch_size": 32,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "seed": 6100,
  "max_hours": 1.0,
  "max_epochs": 200,
  "gates": {
    "valid_coverage": 0.95,
    "contact_position_p95_m": 0.01,
    "contact_orientation_p95_deg": 5.0
  }
}
